# ─────────────────────────────────────────────────────────────
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite o .env.local — ele já está no .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Painel: supabase.com/dashboard/project/<id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-key>

# Service role — bypassa RLS; usar APENAS no servidor, nunca no browser
# Obter em: Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# ── SIAT SQL Server ───────────────────────────────────────────
SIAT_HOST=<host-ou-ip>
SIAT_PORT=10143
SIAT_DATABASE=SiatWeb_Concarga
SIAT_USER=<usuario>
SIAT_PASSWORD=<senha>

# ── Webhooks n8n ──────────────────────────────────────────────
# Único webhook ainda em uso. A importação de NFs virou MSSQL direto (SIAT_*
# acima, via /api/siat) e o envio ao motorista foi removido do escopo.
GERAR_ROTAS_WEBHOOK_URL=https://n8n.rcdigitais.com.br/webhook/gerar-rotas

# ── Vercel Cron ───────────────────────────────────────────────
# Autoriza o GET /api/sync-frota disparado pelo cron (substitui o WF-05 do n8n).
# A Vercel injeta "Authorization: Bearer $CRON_SECRET" automaticamente quando
# esta variável existe no projeto. Gerar com: openssl rand -hex 32
CRON_SECRET=<segredo-aleatorio>

# ── Google Maps ───────────────────────────────────────────────
# Habilitar: Geocoding API + Directions API
# console.cloud.google.com/apis/credentials
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<chave-api>
